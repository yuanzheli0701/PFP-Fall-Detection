# Python / local environment
.venv/
__pycache__/
*.py[cod]

# IDE: keep the shared PyCharm run configurations, ignore user state
.idea/*
!.idea/runConfigurations/
!.idea/runConfigurations/*.xml

# Logs and temporary verification folders
*.log
_build_check/
_pipeline_backup_*/
~$*

# The OSF archive is a compressed duplicate of data_raw/ and exceeds GitHub's 100 MB file limit.
03_Other/Project_Inputs/yjgdv-osfstorage-archive.zip

# Third-party papers and figures are not redistributed in this public repository.
03_Other/Literature_And_Previous_Stage/Bibliographie_PDF/
03_Other/Literature_And_Previous_Stage/_imgs/

# Linked dependency folders inside the archived deck builds.
03_Other/**/node_modules/
